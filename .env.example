# AWS Enterprise RAG Platform — backend service configuration.
#
# Copy this file to `backend/.env` and adjust as needed:
#     cp .env.example backend/.env
#
# Every variable is optional; the defaults below match the application defaults,
# so the service runs without a .env file at all.

# --- Service identity ---
APP_NAME=aws-enterprise-rag-platform
APP_DISPLAY_NAME=AWS Enterprise RAG Platform
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_API_VERSION=v1
APP_API_V1_PREFIX=/api/v1

# --- HTTP server ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
APP_REQUEST_ID_HEADER=X-Request-ID

# --- Persistence ---
# Any SQLAlchemy database URL. SQLite keeps local development zero-configuration;
# the AWS deployment points this at PostgreSQL behind the same repositories.
APP_DATABASE_URL=sqlite:///./rag.db

# --- Document storage ---
# Root directory used by the local filesystem storage adapter. The AWS deployment
# replaces it with Amazon S3 behind the same storage port.
APP_STORAGE_DIR=./data
# Largest document accepted by the upload endpoint, in bytes (default 10 MiB).
APP_MAX_UPLOAD_SIZE_BYTES=10485760

# --- Ingestion ---
# Chunk sizes are counted in characters, not model tokens: counting tokens needs the
# tokenizer of the model that will consume the text. See ADR 0003.
APP_CHUNK_SIZE_CHARS=1200
# Must be smaller than APP_CHUNK_SIZE_CHARS.
APP_CHUNK_OVERLAP_CHARS=200
# Bucket count of the local lexical embedding model. Changing it invalidates every
# stored embedding, because the index rejects vectors of a different width.
APP_EMBEDDING_DIMENSIONS=256
# Worker thread that ingests queued documents. Tests disable it and drive the pipeline
# directly so that nothing depends on timing.
APP_INGESTION_WORKER_ENABLED=true
APP_INGESTION_POLL_SECONDS=0.5
# Documents the worker takes per cycle.
APP_INGESTION_BATCH_SIZE=10

# --- Observability ---
# APP_LOG_LEVEL: CRITICAL | ERROR | WARNING | INFO | DEBUG
APP_LOG_LEVEL=INFO
# APP_LOG_FORMAT: json (CloudWatch-friendly) | console (human-readable)
APP_LOG_FORMAT=json

# --- Retrieval ---
# Passages retrieved and answered from, unless a request overrides top_k.
APP_RETRIEVAL_TOP_K=5
# Similarity below which a passage is not evidence. Raising it makes the platform
# report insufficient evidence sooner. Its useful value depends on the embedding model.
APP_RETRIEVAL_MIN_SCORE=0.1
# Candidates fetched per requested passage when reranking is enabled, so the reranker
# has something to choose between.
APP_RETRIEVAL_CANDIDATE_MULTIPLIER=4
# Reranking is off by default: it has not been measured against the unranked baseline
# yet, and Phase 5 is what decides. See ADR 0004.
APP_RERANK_ENABLED=false
# Character budget for the context handed to the answer generator.
APP_CONTEXT_MAX_CHARS=6000

# --- Answer generation ---
# APP_GENERATION_PROVIDER: local (extractive, offline, no model) | bedrock
APP_GENERATION_PROVIDER=local
# Used when the provider is bedrock. Requires the AWS SDK: pip install -e '.[aws]'
# and credentials from the ambient AWS chain (environment, profile, or instance role).
APP_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
APP_BEDROCK_REGION=us-east-1
APP_GENERATION_MAX_TOKENS=1024
APP_GENERATION_TEMPERATURE=0.0

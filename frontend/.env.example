# Copy to `.env.local` (git-ignored) and fill in the values for your Cognito stack.
#
# These are build-time variables: Vite inlines every `VITE_` value into the JavaScript
# bundle, so treat all of them as public. The Cognito app client must be a *public* client
# (no secret); the sign-in flow is authorization code + PKCE, which needs no secret.
#
# Leave both VITE_COGNITO_DOMAIN and VITE_COGNITO_CLIENT_ID empty (or delete them) to run
# with authentication OFF: no redirect, no bearer header, the app behaves as it did before
# Cognito existed. That is the default the local stack and the screenshots use.

# Cognito hosted UI domain, without a scheme. The app builds https://<domain>/oauth2/...
# e.g. my-app.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# The public app client id.
VITE_COGNITO_CLIENT_ID=

# Where Cognito returns the authorization code. Must be listed as an allowed callback URL
# on the app client. Defaults to <window.location.origin>/callback.
# VITE_COGNITO_REDIRECT_URI=http://127.0.0.1:5173/callback

# Where Cognito sends the browser after sign-out. Must be listed as an allowed logout URL
# on the app client. Defaults to <window.location.origin>/.
# VITE_COGNITO_LOGOUT_URI=http://127.0.0.1:5173/

# Space-separated OAuth scopes. Defaults to `openid email profile`.
# VITE_COGNITO_SCOPES=openid email profile

# Base URL for API calls. Empty means same origin: the dev server proxies /api to the
# backend, and a deployment serves the static build and the API from one origin.
# VITE_API_BASE_URL=

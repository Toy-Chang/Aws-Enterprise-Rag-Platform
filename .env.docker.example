# Template for the compose stack, not for the API service directly.
#
#   cp .env.docker.example .env
#
# `docker compose` reads `.env` from this directory automatically and interpolates the
# values into docker-compose.yml; every one of them has a fallback there, so the stack
# starts without this file at all. `.env` is gitignored (as it should be: this is where a
# real deployment's credentials go) and this template holds only local defaults.
#
# The application's own settings are documented in `backend/.env.example`. Most of them
# are not listed here because compose pins them to the local adapters; the ones below are
# exposed because changing them is routine or because a deployment must change them.
#
# NOTE: `.gitignore` in this repository ignores `.env.*` except `.env.example`, so this
# file has to be force-added (`git add -f .env.docker.example`) or the pattern has to
# allow it, otherwise it will not be committed and the stack will still work from the
# defaults in docker-compose.yml.

# --- Ports on the host ---------------------------------------------------------------
# 8080 for the UI and 8000 for the API. The API port is published as well, so the OpenAPI
# page and curl work without going through the SPA's proxy.
FRONTEND_PORT=8080
BACKEND_PORT=8000
# The database is not published by default. Uncomment the ports block in the postgres
# service and set this only to inspect it with a local client.
# POSTGRES_PORT=5432

# --- Database ------------------------------------------------------------------------
# Local-only credentials. A deployment must replace both, and must not reuse this file.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag

# --- Backend behaviour ---------------------------------------------------------------
# `local` keeps the permissive local defaults. `production` is refused by the application
# while authentication is off (`APP_AUTH_BACKEND=none`), because an open API in production
# is not a configuration to warn about -- see docker/README.md.
APP_ENVIRONMENT=local

APP_LOG_FORMAT=json
APP_LOG_LEVEL=INFO

# The score below which the platform reports that it has no evidence. It is defined on the
# cosine scale and depends on the embedding model, so it is changed only after measuring.
APP_RETRIEVAL_TOP_K=5
APP_RETRIEVAL_MIN_SCORE=0.1

# --- Vector index --------------------------------------------------------------------
# `memory` = the in-process exact index (the default, no extra service).
# `opensearch` = the single-node service behind the `opensearch` profile, which then has
# to be started with `docker compose --profile opensearch up -d`. Changing this means
# re-ingesting: the index mapping is created with APP_EMBEDDING_DIMENSIONS.
APP_VECTOR_STORE_BACKEND=memory
APP_OPENSEARCH_ENDPOINT=http://opensearch:9200
APP_OPENSEARCH_INDEX=rag-chunks
# Placeholders: this node disables its security plugin and ignores them, but the adapter
# signs with SigV4 when they are absent, which fails without AWS credentials.
APP_OPENSEARCH_USERNAME=admin
APP_OPENSEARCH_PASSWORD=admin

# --- Frontend build ------------------------------------------------------------------
# Empty means "the same origin I am served from", which is what the nginx proxy makes
# work. Set it to another origin (no trailing slash) only to take the API out of this
# stack; the backend has no CORS configuration, so a browser would then be blocked.
VITE_API_BASE_URL=

# --- Authentication -------------------------------------------------------------------
# `none` keeps the local stack open. `cognito` requires the three values below and makes
# the frontend sign users in against the pool; APP_ENVIRONMENT must stay `local`, because
# the application refuses to start with authentication off in production.
APP_AUTH_BACKEND=none
APP_COGNITO_USER_POOL_ID=
APP_COGNITO_CLIENT_ID=
APP_COGNITO_REGION=eu-west-1

# --- Frontend build (baked in at build time, not read at run time) ---------------------
# VITE_COGNITO_DOMAIN=
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REDIRECT_URI=http://127.0.0.1:8080/callback
# VITE_COGNITO_LOGOUT_URI=http://127.0.0.1:8080/

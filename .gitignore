# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# --- Environment / secrets ---
# Never commit real configuration or credentials.
.env
.env.*
# ...except the compose template, which carries no secret and is meant to be committed.
!.env.docker.example
!.env.example
*.pem
*.key

# --- Local application data ---
# SQLite database and stored documents written by the local adapters.
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# --- Node / frontend ---
node_modules/
*.local
# Vite's cache and a Vitest coverage report.
.vite/
coverage/

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store

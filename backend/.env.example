# Example configuration for the API service.
#
# Every value below is the default the application runs with, so this file documents the
# settings rather than changing them. Copy it to `.env` and edit what a deployment needs;
# `.env` is ignored by git and nothing secret belongs in this template.
#
# Only the AWS section is required to run against AWS. The platform runs entirely locally
# with this file absent.

# --- Service identity ---
# APP_NAME=aws-enterprise-rag-platform
# APP_DISPLAY_NAME=AWS Enterprise RAG Platform
APP_ENVIRONMENT=local
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Persistence ---
# The local default. For PostgreSQL with pgvector, use a driver URL.
APP_DATABASE_URL=sqlite:///./rag.db

# --- Document storage: local filesystem or S3 ---
APP_STORAGE_BACKEND=local
APP_STORAGE_DIR=./data
# APP_STORAGE_BACKEND=s3
# APP_S3_BUCKET=my-rag-documents
# APP_S3_PREFIX=documents
# APP_S3_REGION=us-east-1

# --- Ingestion ---
APP_CHUNK_SIZE_CHARS=1200
APP_CHUNK_OVERLAP_CHARS=200
# The local worker polls the database for documents waiting to be ingested. A deployment
# that uses a queue turns it off and lets the consumer drive ingestion instead.
APP_INGESTION_WORKER_ENABLED=true
APP_INGESTION_POLL_SECONDS=0.5

# --- Embeddings: local lexical model or a Bedrock model ---
APP_EMBEDDING_PROVIDER=local
APP_EMBEDDING_DIMENSIONS=256
# APP_EMBEDDING_PROVIDER=bedrock
# APP_EMBEDDING_DIMENSIONS=1024
# APP_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# APP_BEDROCK_REGION=us-east-1

# --- Vector index: in-process memory or OpenSearch ---
APP_VECTOR_STORE_BACKEND=memory
# APP_VECTOR_STORE_BACKEND=opensearch
# APP_OPENSEARCH_ENDPOINT=https://search-example.eu-west-1.es.amazonaws.com
# APP_OPENSEARCH_INDEX=rag-chunks
# APP_OPENSEARCH_REGION=eu-west-1
# APP_OPENSEARCH_SERVERLESS=false
# APP_OPENSEARCH_VERIFY_CERTS=true
# Leave both unset to sign requests with SigV4 using the SDK's credentials. Set both to
# use basic authentication; setting only one is refused at startup.
# APP_OPENSEARCH_USERNAME=platform
# APP_OPENSEARCH_PASSWORD=

# --- Retrieval and generation ---
APP_RETRIEVAL_TOP_K=5
# The score below which the platform reports that it has no evidence. It depends on the
# embedding model, so it has to be revisited when the model changes.
APP_RETRIEVAL_MIN_SCORE=0.1
APP_RERANK_ENABLED=false
APP_CONTEXT_MAX_CHARS=6000
# With the Bedrock generator the answers are generated rather than quoted, and the
# deployment needs credentials and model access.
APP_GENERATION_PROVIDER=local
APP_GENERATION_MAX_TOKENS=1024
APP_GENERATION_TEMPERATURE=0.0
# APP_GENERATION_PROVIDER=bedrock
# APP_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# --- Observability ---
APP_LOG_LEVEL=INFO
# `console` is readable in a terminal; `json` is what a log pipeline expects.
APP_LOG_FORMAT=json
